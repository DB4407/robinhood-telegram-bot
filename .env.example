# Robinhood & Telegram Trading Bot Environment Configuration
# Copy this file to .env and fill in your actual credentials. NEVER commit .env to version control!

# Telegram Bot Credentials (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USER_ID=your_numeric_telegram_chat_id_here

# Robinhood Brokerage Credentials
RH_ACCOUNT=your_robinhood_account_number_here
ROBINHOOD_TOKEN=your_robinhood_bearer_or_api_token_here

# Optional: Google Gemini AI Key (for Mini-Rob conversational intelligence)
GEMINI_API_KEY=your_gemini_api_key_here
