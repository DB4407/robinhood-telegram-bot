# ==============================================================================
# 🚀 Autonomous Trading & Portfolio Guardian Bot - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Fill in your credentials below.
# 3. NEVER commit your actual .env file to Git or share it publicly!
# ==============================================================================

# ------------------------------------------------------------------------------
# 📱 Telegram Bot Configuration
# ------------------------------------------------------------------------------
# 1. Create a bot via @BotFather on Telegram (https://t.me/BotFather) and paste the token here:
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 2. Get your numeric Telegram User ID from @userinfobot (https://t.me/userinfobot).
#    SECURITY: Only messages from this ID will be processed. All other users are blocked.
AUTHORIZED_USER_ID=your_numeric_telegram_user_id_here

# 3. Your display name for the bot's conversational greetings (default: Trader):
USER_NAME=Trader

# ------------------------------------------------------------------------------
# 📈 Robinhood Brokerage API
# ------------------------------------------------------------------------------
# Your Robinhood bearer or MCP API token:
ROBINHOOD_TOKEN=your_robinhood_bearer_or_api_token_here

# Optional: Your specific 9-digit Robinhood account number.
# If left blank, the bot automatically discovers and binds your primary active account.
RH_ACCOUNT=

# ------------------------------------------------------------------------------
# 🧠 AI Pilot & Large Language Model Inference
# ------------------------------------------------------------------------------
# Recommended: Groq LPU API Key (Get a free key at https://console.groq.com)
# Powers ultra-low-latency institutional AI Pilot trade deliberations & briefings
# using models like openai/gpt-oss-120b and qwen/qwen3.6-27b.
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini API Key (Get a free key at https://aistudio.google.com)
# Acts as conversational intelligence fallback for deep market thesis explanations.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# ⚙️ Server & Network Configuration
# ------------------------------------------------------------------------------
# Localhost port for internal health check server (default: 10000)
PORT=10000
